# Copia questo file in `.env` (ignorato da git) e compila i valori: una riga CHIAVE=valore, senza virgolette e senza
# commenti sulla stessa riga. Le stesse chiavi vanno nei segreti del repository GitHub: le copia
# `python3 segreti.py --repo utente/nome-repo`. Il numero fra parentesi è il passo del README in cui si ottiene il valore.

# (2) Token dell'integrazione interna di Notion («Internal Integration Secret», comincia con ntn_).
NOTION_TOKEN=
# (2) Id del data source della tabella Contenuti: dalla risposta di GET /v1/databases/<id>, non l'id della tabella.
NOTION_DATA_SOURCE_ID=
# (2) Facoltativo: id dell'utente Notion da menzionare nei commenti (GET /v1/users); vuoto = commenti senza menzione.
NOTION_UTENTE_ID=

# (3) Il file JSON della chiave dell'account di servizio Google, in base64 su una riga sola: base64 -i chiave.json | tr -d '\n'
GOOGLE_SA_KEY_B64=

# (4) Id dell'app Meta (Impostazioni dell'app > Di base).
META_APP_ID=
# (4) Chiave segreta dell'app Meta (stessa pagina): serve solo a controllare la scadenza del token.
META_APP_SECRET=
# (4) Id della Pagina Facebook collegata all'account Instagram.
META_PAGE_ID=
# (4) Id dell'account Instagram professionale: GET /<id-pagina>?fields=instagram_business_account
META_IG_USER_ID=
# (4) Token della Pagina, ricavato da un token utente a lunga durata: non scade.
META_PAGE_TOKEN=

# (4 bis, facoltativo) Id client dell'app LinkedIn (scheda Auth): serve solo a linkedin_login.py.
LINKEDIN_CLIENT_ID=
# (4 bis) Chiave segreta dell'app LinkedIn: serve solo a linkedin_login.py.
LINKEDIN_CLIENT_SECRET=
# (4 bis) Lo scrive linkedin_login.py: token di accesso, dura circa 60 giorni.
LINKEDIN_ACCESS_TOKEN=
# (4 bis) Lo scrive linkedin_login.py: urn:li:person:<id>, l'autore dei post.
LINKEDIN_PERSON_URN=
# (4 bis) Lo scrive linkedin_login.py: scadenza del token, AAAA-MM-GG (avvisi.py avvisa 14 giorni prima).
LINKEDIN_TOKEN_SCADE=

# Facoltativo: fuso orario delle date in Notion e degli orari stampati; vuoto = Europe/Rome.
FUSO_ORARIO=
